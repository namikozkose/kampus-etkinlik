            "type": "text/javascript",
            "exec": [
              "const list = pm.response.json();",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Dizi ve boş değil\", () => pm.expect(list).to.be.an(\"array\").that.is.not.empty);",
